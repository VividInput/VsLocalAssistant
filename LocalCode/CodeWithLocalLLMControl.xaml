<UserControl x:Class="LocalCode.CodeWithLocalLLMControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400"
             Name="MyToolWindow">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ComboBoxStyleKey}}"/>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}"/>
    </UserControl.Resources>
    <Grid x:Name="responseControlsGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="responseScrollViewer" Grid.Row="0">
            <StackPanel x:Name="responseStackPanel" CanVerticallyScroll="True" Margin="6">
            </StackPanel>
        </ScrollViewer>
        <TextBox x:Name="queryTextBox" Grid.Row="1"
                 Padding="6,3"
                 Margin="6,3,6,3"
                 Text="Your question here!"
                 KeyDown="queryTextBox_KeyDownAsync"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbModels" Grid.Column="0"
                      Padding="6,3"
                      Margin="6,3,3,6"
                      ToolTip="Select Local model to ask question"/>
            <Button x:Name="submitButton" Grid.Column="1"
                    Content="Submit"
                    Padding="18,0"
                    Margin="3,3,6,6"
                    Click="submitButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
