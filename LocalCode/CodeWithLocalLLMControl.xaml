<UserControl x:Class="LocalCode.CodeWithLocalLLMControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400"
             Name="MyToolWindow">
    <Grid x:Name="responseControlsGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <ScrollViewer x:Name="responseScrollViewer">
                <StackPanel x:Name="responseStackPanel" CanVerticallyScroll="True">
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="1" >
            <TextBox x:Name="queryTextBox"
                     Margin="10"
                     Text="Your question here!"
                     KeyDown="queryTextBox_KeyDownAsync"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbModels" Grid.Column="0"
                      Margin="10"
                      ToolTip="Select Local model to ask question"/>
            <Button x:Name="submitButton" Grid.Column="1"
                    Content="Submit"
                    Padding="18,0"
                    Margin="10"
                    Click="submitButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
